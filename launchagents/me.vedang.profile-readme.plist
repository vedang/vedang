<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>me.vedang.profile-readme</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/fish</string>
    <string>-l</string>
    <string>-c</string>
    <string>bb refresh</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/vedang/src/vedang/vedang/vedang.root</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key><string>/Users/vedang/Library/Logs/profile-readme.log</string>
  <key>StandardErrorPath</key><string>/Users/vedang/Library/Logs/profile-readme.error.log</string>
</dict>
</plist>
